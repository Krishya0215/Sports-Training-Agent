<mxfile host="app.diagrams.net">
  <diagram id="multi-agent-system" name="多智能体协同系统架构">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="多智能体协同系统架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="450" height="30" as="geometry"/>
        </mxCell>

        <!-- 输入 -->
        <mxCell id="input" value="用户请求" style="ellipse;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 请求路由器 -->
        <mxCell id="router" value="请求路由器" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="130" y="150" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 工作流引擎 -->
        <mxCell id="workflow" value="工作流引擎" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 教练 -->
        <mxCell id="planning" value="训练规划教练" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="technique" value="技术指导教练" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="300" y="250" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="recovery" value="运动康复教练" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="480" y="250" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 综合输出器 -->
        <mxCell id="synthesizer" value="综合输出器" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="360" y="350" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 输出 -->
        <mxCell id="output" value="综合响应" style="ellipse;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="360" y="460" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 外部服务 -->
        <mxCell id="llm" value="大语言模型" style="shape=cloud;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="660" y="200" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rag" value="RAG检索" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="660" y="280" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="memory" value="记忆服务" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="660" y="340" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="input" target="router">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="router" target="workflow">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="workflow" target="planning">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="workflow" target="technique">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="workflow" target="recovery">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="planning" target="synthesizer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="technique" target="synthesizer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="recovery" target="synthesizer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="synthesizer" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1" edge="1" parent="1" source="llm" target="synthesizer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1" edge="1" parent="1" source="rag" target="workflow">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1" edge="1" parent="1" source="memory" target="synthesizer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
