<mxfile host="app.diagrams.net">
  <diagram id="multimodal-diagram" name="多模态处理流程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="多模态文档处理流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="420" height="30" as="geometry"/>
        </mxCell>

        <!-- START: 文件输入 -->
        <mxCell id="s1" value="文件输入&lt;br&gt;（PDF / Markdown / TXT）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="235" y="55" width="250" height="55" as="geometry"/>
        </mxCell>

        <!-- D1: 格式判断 -->
        <mxCell id="d1" value="文件格式判断" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="255" y="160" width="210" height="65" as="geometry"/>
        </mxCell>

        <!-- 三条分支标签 -->
        <mxCell id="lbl-pdf" value=".pdf" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="85" y="185" width="40" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lbl-md" value=".md" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="335" y="238" width="40" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lbl-txt" value=".txt" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="185" width="40" height="20" as="geometry"/>
        </mxCell>

        <!-- ========== PDF 分支（左列，x≈60-270）========== -->
        <!-- D2: MarkItDown可用? -->
        <mxCell id="d2" value="MarkItDown&lt;br&gt;可用？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="170" height="60" as="geometry"/>
        </mxCell>

        <!-- PDF-主路径: MarkItDown -->
        <mxCell id="pm" value="MarkItDown.convert()&lt;br&gt;PDF → Markdown 结构化文本&lt;br&gt;processing_method=markitdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="390" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- PDF-备用路径: PyPDF -->
        <mxCell id="pb" value="PyPDFLoader（降级）&lt;br&gt;逐页提取纯文本&lt;br&gt;processing_method=pypdf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="390" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- 图像提取 -->
        <mxCell id="img1" value="PyMuPDF (fitz)&lt;br&gt;逐页提取嵌入图像&lt;br&gt;page.get_images()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="515" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- 保存图像 -->
        <mxCell id="img2" value="保存图像&lt;br&gt;data/extracted_images/&lt;br&gt;{pdf_name}/pageN_imgM.ext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="635" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Qwen-VL-Max -->
        <mxCell id="vl" value="Qwen-VL-Max&lt;br&gt;多模态图像描述生成&lt;br&gt;detail_level=detailed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="750" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- 图像描述块 -->
        <mxCell id="imgdoc" value="图像描述文档块&lt;br&gt;content_type=image_description&lt;br&gt;model=qwen-vl-max" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="870" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- ========== MD 分支（中列，x≈310-450）========== -->
        <mxCell id="md1" value="UTF-8 直接读取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="285" width="170" height="45" as="geometry"/>
        </mxCell>

        <!-- ========== TXT 分支（右列，x≈540-680）========== -->
        <mxCell id="txt1" value="UTF-8 直接读取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="285" width="160" height="45" as="geometry"/>
        </mxCell>

        <!-- MD 分割 -->
        <mxCell id="mdsplit" value="MarkdownHeaderSplitter&lt;br&gt;按 H1/H2/H3 结构分块&lt;br&gt;→ RecursiveCharSplitter&lt;br&gt;chunk_size=800, overlap=100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="190" height="80" as="geometry"/>
        </mxCell>

        <!-- TXT 分割 -->
        <mxCell id="txtsplit" value="RecursiveCharSplitter&lt;br&gt;chunk_size=800&lt;br&gt;chunk_overlap=100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="190" height="65" as="geometry"/>
        </mxCell>

        <!-- ========== 汇合：文本块列表 ========== -->
        <mxCell id="textdocs" value="文本文档块列表&lt;br&gt;（含 PDF文本块 + MD块 + TXT块）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="870" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- 合并 -->
        <mxCell id="mergedoc" value="合并文档块&lt;br&gt;文本块 + 图像描述块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="975" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- 元数据标注 -->
        <mxCell id="meta" value="元数据标注&lt;br&gt;source · file_name · content_type&lt;br&gt;processing_method · model · page_number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="190" y="1075" width="320" height="60" as="geometry"/>
        </mxCell>

        <!-- MD5去重 -->
        <mxCell id="md5" value="MD5 哈希去重&lt;br&gt;防止重复向量化入库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="225" y="1185" width="250" height="50" as="geometry"/>
        </mxCell>

        <!-- ChromaDB -->
        <mxCell id="db" value="ChromaDB&lt;br&gt;text-embedding-v4 向量化&lt;br&gt;持久化存储入库" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="1290" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES ===== -->
        <!-- s1→d1 -->
        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s1" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- d1 → d2 (PDF左) -->
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d1" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="192"/><mxPoint x="145" y="310"/></Array></mxGeometry>
        </mxCell>
        <!-- d1 → md1 (MD中) -->
        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d1" target="md1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- d1 → txt1 (TXT右) -->
        <mxCell id="ea4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="d1" target="txt1" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="192"/><mxPoint x="570" y="307"/></Array></mxGeometry>
        </mxCell>
        <!-- d2 → pm (是) -->
        <mxCell id="ea5" value="是" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;" edge="1" source="d2" target="pm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- d2 → pb (否) -->
        <mxCell id="ea6" value="否" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;" edge="1" source="d2" target="pb" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="310"/><mxPoint x="340" y="310"/><mxPoint x="340" y="422"/></Array></mxGeometry>
        </mxCell>
        <!-- pm → img1 -->
        <mxCell id="ea7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="pm" target="img1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- img1 → img2 -->
        <mxCell id="ea8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="img1" target="img2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- img2 → vl -->
        <mxCell id="ea9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="img2" target="vl" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- vl → imgdoc -->
        <mxCell id="ea10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="vl" target="imgdoc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- md1 → mdsplit -->
        <mxCell id="ea11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="md1" target="mdsplit" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- txt1 → txtsplit -->
        <mxCell id="ea12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="txt1" target="txtsplit" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- pm/pb → textdocs (PDF文本块) -->
        <mxCell id="ea13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="pm" target="textdocs" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="870"/><mxPoint x="270" y="870"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="ea14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="pb" target="textdocs" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="455"/><mxPoint x="340" y="870"/></Array></mxGeometry>
        </mxCell>
        <!-- mdsplit → textdocs -->
        <mxCell id="ea15" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="mdsplit" target="textdocs" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="870"/></Array></mxGeometry>
        </mxCell>
        <!-- txtsplit → textdocs -->
        <mxCell id="ea16" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="txtsplit" target="textdocs" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="870"/><mxPoint x="530" y="870"/></Array></mxGeometry>
        </mxCell>
        <!-- imgdoc → mergedoc -->
        <mxCell id="ea17" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="imgdoc" target="mergedoc" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="1000"/></Array></mxGeometry>
        </mxCell>
        <!-- textdocs → mergedoc -->
        <mxCell id="ea18" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="textdocs" target="mergedoc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- mergedoc → meta -->
        <mxCell id="ea19" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="mergedoc" target="meta" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- meta → md5 -->
        <mxCell id="ea20" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="meta" target="md5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- md5 → db -->
        <mxCell id="ea21" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="md5" target="db" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
