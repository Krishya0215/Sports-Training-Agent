        <!-- Advanced Retriever -->
        <mxCell id="retriever-box" value="高级检索器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#1565c0;fontSize=13;fontStyle=1;" vertex="1" parent="rag-box">
