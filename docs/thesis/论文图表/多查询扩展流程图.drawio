<mxfile host="app.diagrams.net">
  <diagram id="mqe-diagram" name="多查询扩展检索流程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="650" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="多查询扩展（MQE）检索流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="420" height="30" as="geometry"/>
        </mxCell>

        <!-- START: 用户原始问题 -->
        <mxCell id="s1" value="用户原始问题 q" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="55" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- P1: 构建Prompt -->
        <mxCell id="p1" value="构建 Multi-Query Prompt&lt;br&gt;注入 {question} 和 num_queries=3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="165" y="155" width="290" height="55" as="geometry"/>
        </mxCell>

        <!-- P2: LLM生成 -->
        <mxCell id="p2" value="Qwen-Flash LLM&lt;br&gt;temperature=0.7 · max_tokens=2048&lt;br&gt;推理生成多角度查询表述" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="155" y="260" width="310" height="65" as="geometry"/>
        </mxCell>

        <!-- P3: 解析 -->
        <mxCell id="p3" value="StrOutputParser&lt;br&gt;按 \n 分割 · 去空行 · strip()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="175" y="375" width="270" height="55" as="geometry"/>
        </mxCell>

        <!-- P4: 插入原始问题 -->
        <mxCell id="p4" value="插入原始问题至列表首位&lt;br&gt;截取前 num_queries+1 = 4 个查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="165" y="480" width="290" height="55" as="geometry"/>
        </mxCell>

        <!-- 并行查询标注 -->
        <mxCell id="lbl-fork" value="4 路并行检索" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="552" width="180" height="20" as="geometry"/>
        </mxCell>

        <!-- Q0 原始 -->
        <mxCell id="q0" value="Q₀&lt;br&gt;原始问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="585" width="110" height="50" as="geometry"/>
        </mxCell>

        <!-- Q1 变体1 -->
        <mxCell id="q1" value="Q₁&lt;br&gt;变体查询 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="155" y="585" width="110" height="50" as="geometry"/>
        </mxCell>

        <!-- Q2 变体2 -->
        <mxCell id="q2" value="Q₂&lt;br&gt;变体查询 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="585" width="110" height="50" as="geometry"/>
        </mxCell>

        <!-- Q3 变体3 -->
        <mxCell id="q3" value="Q₃&lt;br&gt;变体查询 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="425" y="585" width="110" height="50" as="geometry"/>
        </mxCell>

        <!-- R0 检索 -->
        <mxCell id="r0" value="向量检索&lt;br&gt;top-k=5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="685" width="110" height="50" as="geometry"/>
        </mxCell>

        <!-- R1 检索 -->
        <mxCell id="r1" value="向量检索&lt;br&gt;top-k=5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="155" y="685" width="110" height="50" as="geometry"/>
        </mxCell>

        <!-- R2 检索 -->
        <mxCell id="r2" value="向量检索&lt;br&gt;top-k=5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="685" width="110" height="50" as="geometry"/>
        </mxCell>

        <!-- R3 检索 -->
        <mxCell id="r3" value="向量检索&lt;br&gt;top-k=5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="425" y="685" width="110" height="50" as="geometry"/>
        </mxCell>

        <!-- 合并 -->
        <mxCell id="merge" value="合并所有检索结果&lt;br&gt;最多 4×5 = 20 篇候选文档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="155" y="790" width="300" height="55" as="geometry"/>
        </mxCell>

        <!-- 去重 -->
        <mxCell id="dedup" value="基于 hash(page_content) 去重&lt;br&gt;score_threshold ≥ 0.6 过滤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="155" y="900" width="300" height="55" as="geometry"/>
        </mxCell>

        <!-- 重排序 -->
        <mxCell id="rerank" value="关键词匹配重排序&lt;br&gt;rerank_enabled=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="155" y="1005" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="最终候选文档集" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="195" y="1105" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s1" target="p1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p1" target="p2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p2" target="p3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p3" target="p4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- fork: p4 → Q0,Q1,Q2,Q3 -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p4" target="q0" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p4" target="q1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p4" target="q2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p4" target="q3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Q → R -->
        <mxCell id="e9"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="q0" target="r0" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="q1" target="r1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="q2" target="r2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="q3" target="r3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- join: R → merge -->
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r0" target="merge" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r1" target="merge" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r2" target="merge" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r3" target="merge" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="merge" target="dedup" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="dedup" target="rerank" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="rerank" target="end" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
