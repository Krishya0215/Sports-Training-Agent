<mxfile host="app.diagrams.net">
  <diagram id="hyde-diagram" name="HyDE假设文档嵌入对比">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="HyDE 假设文档嵌入——传统检索 vs HyDE 检索对比" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="660" height="30" as="geometry"/>
        </mxCell>

        <!-- 列标题：传统 -->
        <mxCell id="lbl-trad" value="传统检索" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="240" height="28" as="geometry"/>
        </mxCell>

        <!-- 列标题：HyDE -->
        <mxCell id="lbl-hyde" value="HyDE 检索（本系统采用）" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="440" y="50" width="280" height="28" as="geometry"/>
        </mxCell>

        <!-- 分隔线 -->
        <mxCell id="divider" value="" style="line;strokeColor=#AAAAAA;fillColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="370" y="45" width="10" height="700" as="geometry"/>
        </mxCell>

        <!-- ===== 传统检索 左列 ===== -->
        <!-- T1: 用户查询 -->
        <mxCell id="t1" value="用户查询 q（短句）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- T2: 向量化 -->
        <mxCell id="t2" value="查询向量化&lt;br&gt;text-embedding-v4&lt;br&gt;Embedding(q) → v_q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="205" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- T3: ChromaDB -->
        <mxCell id="t3" value="ChromaDB&lt;br&gt;余弦相似度检索&lt;br&gt;score_threshold=0.6" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="180" height="65" as="geometry"/>
        </mxCell>

        <!-- T4: 问题标注 -->
        <mxCell id="t4" value="⚠ 语义鸿沟&lt;br&gt;短查询向量 v_q 与知识库&lt;br&gt;长文档向量分布差异大&lt;br&gt;召回精度受限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="455" width="230" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== HyDE 右列 ===== -->
        <!-- H1: 用户查询 -->
        <mxCell id="h1" value="用户查询 q（短句）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="100" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- H2: HyDE Prompt -->
        <mxCell id="h2" value="HyDE Prompt 模板&lt;br&gt;注入 {question}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="200" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- H3: LLM生成假设答案 -->
        <mxCell id="h3" value="Qwen-Flash LLM&lt;br&gt;生成假设文档 h&lt;br&gt;（200~300 字专业运动训练答案）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="300" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- H4: 假设答案向量化 -->
        <mxCell id="h4" value="假设文档向量化&lt;br&gt;text-embedding-v4&lt;br&gt;Embedding(h) → v_h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="425" width="220" height="65" as="geometry"/>
        </mxCell>

        <!-- H5: ChromaDB -->
        <mxCell id="h5" value="ChromaDB&lt;br&gt;余弦相似度检索&lt;br&gt;score_threshold=0.6" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="545" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- H6: 效果好 -->
        <mxCell id="h6" value="✅ 语义匹配更精准&lt;br&gt;v_h 与知识库文档向量&lt;br&gt;语义分布高度一致&lt;br&gt;召回质量显著提升" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="665" width="240" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== 底部核心说明 ===== -->
        <mxCell id="note" value="核心思想：用 LLM 生成与知识库文档风格一致的假设文本，&lt;br&gt;以假设文本向量 v_h 代替短查询向量 v_q 进行检索，弥合查询与文档的语义鸿沟" style="text;html=1;strokeColor=#0078D4;fillColor=#E8F4FD;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="55" y="760" width="660" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== 左列 EDGES ===== -->
        <mxCell id="et1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t1" target="t2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="et2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t2" target="t3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="et3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t3" target="t4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== 右列 EDGES ===== -->
        <mxCell id="eh1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="h1" target="h2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eh2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="h2" target="h3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eh3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="h3" target="h4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eh4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="h4" target="h5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eh5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="h5" target="h6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
