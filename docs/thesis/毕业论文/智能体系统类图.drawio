        <mxCell id="rel8" style="endArrow=open;endSize=12;html=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="vector-service" target="retriever-service">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel9" style="endArrow=open;endSize=12;html=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="retriever-service" target="memory-service">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel10" style="endArrow=open;endSize=12;html=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="retriever-service" target="llm-service">
