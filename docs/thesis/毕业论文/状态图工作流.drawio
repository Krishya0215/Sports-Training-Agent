<mxfile host="app.diagrams.net">
  <diagram id="state-graph-workflow" name="状态图工作流">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="LangGraph状态图工作流" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- TrainingState 状态 -->
        <mxCell id="state-node" value="TrainingState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- StateGraph 容器 -->
        <mxCell id="graph-container" value="StateGraph" style="swimlane;startSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="800" height="700" as="geometry"/>
        </mxCell>

        <!-- 节点1: retrieve_knowledge -->
        <mxCell id="node1" value="&lt;b&gt;retrieve_knowledge&lt;/b&gt;&#xa;知识检索节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="graph-container">
          <mxGeometry x="30" y="60" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node1-detail" value="• 高级检索器 (MQE+HyDE)&#xa;• 返回检索文档列表" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="graph-container">
          <mxGeometry x="30" y="80" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 节点2: build_execution_plan -->
        <mxCell id="node2" value="&lt;b&gt;build_execution_plan&lt;/b&gt;&#xa;构建执行计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="graph-container">
          <mxGeometry x="220" y="60" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node2-detail" value="• 分析用户意图&#xa;• 选择参与教练&#xa;• 构建执行批次" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="graph-container">
          <mxGeometry x="220" y="80" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 节点3: execute_agents -->
        <mxCell id="node3" value="&lt;b&gt;execute_agents&lt;/b&gt;&#xa;执行智能体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="graph-container">
          <mxGeometry x="410" y="60" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node3-detail" value="• 按批次执行教练&#xa;• 并行处理&#xa;• 收集各教练结果" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="graph-container">
          <mxGeometry x="410" y="80" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 节点4: synthesize_response -->
        <mxCell id="node4" value="&lt;b&gt;synthesize_response&lt;/b&gt;&#xa;综合响应" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="graph-container">
          <mxGeometry x="600" y="60" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node4-detail" value="• 整合教练建议&#xa;• 生成统一响应&#xa;• 格式化输出" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="graph-container">
          <mxGeometry x="600" y="80" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 节点5: update_memory -->
        <mxCell id="node5" value="&lt;b&gt;update_memory&lt;/b&gt;&#xa;更新记忆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="graph-container">
          <mxGeometry x="30" y="180" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node5-detail" value="• 工作记忆更新&#xa;• 情景记忆记录&#xa;• 感知记忆添加" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="graph-container">
          <mxGeometry x="30" y="200" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- END 节点 -->
        <mxCell id="end-node" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="graph-container">
          <mxGeometry x="220" y="180" width="80" height="50" as="geometry"/>
        </mxCell>

        <!-- 工作流边 -->
        <mxCell id="edge1" value="" style="endArrow=block;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="graph-container" source="node1" target="node2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge2" value="" style="endArrow=block;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="graph-container" source="node2" target="node3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge3" value="" style="endArrow=block;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="graph-container" source="node3" target="node4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge4" value="" style="endArrow=block;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="graph-container" source="node1" target="node5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge5" value="" style="endArrow=block;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="graph-container" source="node4" target="end-node">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge6" value="" style="endArrow=block;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="graph-container" source="node5" target="end-node">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 状态流转说明 -->
        <mxCell id="flow-box" value="状态流转说明" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#fff2cc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;" vertex="1" parent="graph-container">
          <mxGeometry x="30" y="300" width="720" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="flow-step1" value="&lt;b&gt;步骤1: 知识检索&lt;/b&gt;&#xa;使用AdvancedRetriever进行知识检索，整合MQE和HyDE两种策略。&#xa;返回的文档会存储在state[&quot;retrieved_docs&quot;]中。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="flow-box">
          <mxGeometry x="10" y="26" width="700" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="flow-step2" value="&lt;b&gt;步骤2: 构建执行计划&lt;/b&gt;&#xa;根据用户意图和检索结果，选择参与的教练并构建执行计划。&#xa;执行计划采用批次化设计，支持教练之间的依赖关系。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="flow-box">
          <mxGeometry x="10" y="86" width="700" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="flow-step3" value="&lt;b&gt;步骤3: 执行智能体&lt;/b&gt;&#xa;按批次执行各教练智能体。同批次的教练并行执行以提高效率。&#xa;后续批次可以获取前序批次教练的输出作为上下文。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="flow-box">
          <mxGeometry x="10" y="146" width="700" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="flow-step4" value="&lt;b&gt;步骤4: 综合响应&lt;/b&gt;&#xa;使用Synthesizer整合所有教练的建议，生成统一的响应。&#xa;综合器会根据不同教练的专业特长进行融合。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="flow-box">
          <mxGeometry x="10" y="206" width="700" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="flow-step5" value="&lt;b&gt;步骤5: 更新记忆&lt;/b&gt;&#xa;将本次交互信息记录到记忆系统中，包括工作记忆、&#xa;情景记忆和感知记忆。记忆摘要将返回给用户。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="flow-box">
          <mxGeometry x="10" y="266" width="700" height="60" as="geometry"/>
        </mxCell>

        <!-- 并行执行说明 -->
        <mxCell id="parallel-box" value="并行执行机制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="graph-container">
          <mxGeometry x="320" y="200" width="380" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="parallel-content" value="同批次教练使用ThreadPoolExecutor并行执行，&#xa;利用多线程提高响应速度" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="graph-container">
          <mxGeometry x="330" y="215" width="360" height="30" as="geometry"/>
        </mxCell>

        <!-- 状态数据流向 -->
        <mxCell id="data-flow" value="数据流向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="flow-legend1" value="TrainingState在节点间流转，&#xa;每个节点读取和更新state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="590" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="flow-legend2" value="各节点通过函数签名&#xa;def node(state: TrainingState)&#xa;来访问和修改状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="410" y="590" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- TrainingState 到 StateGraph 的连接 -->
        <mxCell id="state-conn" value="" style="endArrow=open;endSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="state-node" target="graph-container">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
