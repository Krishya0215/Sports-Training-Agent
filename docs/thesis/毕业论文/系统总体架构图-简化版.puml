@startuml 系统整体分层架构图
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70

title <size:18>运动训练多智能体协同支持系统 - 整体分层架构</size>

package "用户层" as user_layer #E8F5E9 {
    actor "用户\n(运动员/教练)" as user
}

package "前端展示层\n(Vue.js + Element Plus)" as frontend #E3F2FD {
    component "登录注册" as login
    component "AI教练对话" as chat
    component "知识库管理" as kb
    component "训练记录" as training
    component "个人中心" as profile
}

package "后端服务层\n(FastAPI)" as backend #FFF3E0 {
    component "认证服务" as auth
    component "API网关" as gateway
    component "聊天服务" as chat_api
    component "知识库服务" as kb_api
    component "训练服务" as training_api
    component "记忆服务" as memory_api
}

package "多智能体层\n(LangGraph)" as agent #FCE4EC {
    component "请求路由器" as router
    component "工作流引擎" as workflow
    component "训练规划教练" as planning
    component "技术指导教练" as technique
    component "运动康复教练" as recovery
    component "综合输出器" as synthesizer
}

package "RAG检索系统" as rag #F3E5F5 {
    component "高级检索器" as retriever
    component "文档处理器" as doc_proc
    component "向量存储服务" as vector_svc
}

package "记忆管理模块" as memory #E0F7FA {
    component "工作记忆" as working
    component "情景记忆" as episodic
    component "语义记忆" as semantic
    component "感知记忆" as perceptual
}

package "数据存储层" as data #ECEFF1 {
    database "向量数据库\n(Chroma)" as vector_db
    database "关系数据库\n(SQLite)" as sql_db
    folder "知识库文件" as files
}

package "模型服务层\n(通义千问)" as model #FFF8E1 {
    cloud "大语言模型" as llm
    cloud "嵌入模型" as embedding
}

' 用户到前端
user --> login : 登录/注册
user --> chat : AI对话
user --> kb : 知识管理
user --> training : 训练记录
user --> profile : 个人设置

' 前端到后端
login --> auth : 认证请求
chat --> chat_api : 对话请求
kb --> kb_api : 知识库操作
training --> training_api : 训练数据
profile --> memory_api : 画像更新

' 后端内部
auth --> gateway
chat_api --> gateway
kb_api --> gateway
training_api --> gateway
memory_api --> gateway

' 后端到多智能体
chat_api --> router : 路由请求
chat_api --> memory_api : 获取记忆
router --> workflow : 执行计划
workflow --> planning : 规划
workflow --> technique : 技术
workflow --> recovery : 康复
planning --> synthesizer : 整合
technique --> synthesizer : 整合
recovery --> synthesizer : 整合

' 多智能体到RAG
workflow --> retriever : 检索知识
retriever --> vector_svc : 向量查询
doc_proc --> vector_svc : 文档处理
vector_svc --> vector_db : 存储查询

' 记忆管理
memory_api --> working
memory_api --> episodic
memory_api --> semantic
memory_api --> perceptual

' 数据存储
vector_db --> embedding : 向量化
memory_api --> sql_db : 持久化
auth --> sql_db : 用户数据
training_api --> sql_db : 训练记录
kb_api --> files : 文件加载

' 模型调用
planning --> llm
technique --> llm
recovery --> llm
synthesizer --> llm
router --> llm
retriever --> llm : HyDE
doc_proc --> embedding : 嵌入

@enduml
