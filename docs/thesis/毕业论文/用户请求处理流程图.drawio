<mxfile host="app.diagrams.net">
  <diagram id="user-request-flow" name="用户请求处理流程图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="用户请求处理流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="400" height="30" as="geometry"/>
        </mxCell>

        <!-- 用户请求 -->
        <mxCell id="request" value="用户请求" style="ellipse;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="330" y="60" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 获取上下文 -->
        <mxCell id="context" value="获取上下文" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="100" y="160" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="1.从工作记忆获取" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="110" y="190" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="2.格式化为字符串" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="110" y="215" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="3.返回给RAG使用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="110" y="240" width="120" height="20" as="geometry"/>
        </mxCell>

        <!-- RAG检索 -->
        <mxCell id="rag" value="RAG检索与答案生成" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="1.问题分类" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="310" y="185" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="2.向量检索" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="310" y="210" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="3.生成答案" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="310" y="235" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="4.综合输出" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="310" y="260" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- 记录交互 -->
        <mxCell id="record" value="记录交互" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="500" y="160" width="140" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="record-label" value="参数" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="175" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="question:用户问题" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="530" y="205" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="answer:系统回答" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="530" y="225" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="retrieved:检索文档" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="530" y="245" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="metadata:元数据" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="530" y="265" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="工作流,参与教练" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="530" y="285" width="120" height="20" as="geometry"/>
        </mxCell>

        <!-- 记忆更新 -->
        <mxCell id="memory" value="记忆更新" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="100" y="310" width="540" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="工作记忆" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="120" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="情景记忆" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="160" y="330" width="120" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="感知记忆" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="120" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="m1-detail" value="添加到队列" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="35" y="345" width="90" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="m2-detail" value="添加新事件" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="175" y="345" width="90" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="m3-detail" value="添加图像信息" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="315" y="345" width="90" height="20" as="geometry"/>
        </mxCell>

        <!-- 记忆摘要 -->
        <mxCell id="summary" value="记忆摘要" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="540" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="summary-title" value="返回数据" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="140" y="445" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="working_size:消息数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="30" y="480" width="140" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="episodic_size:事件数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="30" y="500" width="140" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="semantic_count:概念数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="30" y="520" width="140" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="docs_count:文档数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="30" y="540" width="140" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="images_count:图像数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="140" height="20" as="geometry"/>
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="request" target="context">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="context" target="rag">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="rag" target="record">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="record" target="memory">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="memory" target="summary">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;edge=1" parent="1" source="m1" target="m1-detail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;edge=1" parent="1" source="m2" target="m2-detail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;edge=1" parent="1" source="m3" target="m3-detail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
