<mxfile host="app.diagrams.net">
  <diagram id="rag-system" name="RAG检索系统架构">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="550" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="RAG检索系统架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="450" height="30" as="geometry"/>
        </mxCell>

        <!-- 输入 -->
        <mxCell id="input" value="用户查询" style="ellipse;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 高级检索器 -->
        <mxCell id="retriever" value="高级检索器" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="130" y="150" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 文档处理器 -->
        <mxCell id="doc-proc" value="文档处理器" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 向量存储 -->
        <mxCell id="vector" value="向量存储服务" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="550" y="150" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- 输出 -->
        <mxCell id="output" value="检索结果" style="ellipse;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="360" y="320" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 外部服务 -->
        <mxCell id="llm" value="大语言模型" style="shape=cloud;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="700" y="130" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="embedding" value="嵌入模型" style="shape=cloud;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="700" y="220" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 数据库 -->
        <mxCell id="db" value="向量数据库" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15" vertex="1" parent="1">
          <mxGeometry x="700" y="310" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="input" target="retriever">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="retriever" target="vector">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="doc-proc" target="vector">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="vector" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1" edge="1" parent="1" source="llm" target="retriever">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1" edge="1" parent="1" source="vector" target="embedding">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1" edge="1" parent="1" source="vector" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;edgeStyle=none" edge="1" parent="1" source="doc-proc" target="embedding">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
