<mxfile host="app.diagrams.net">
  <diagram id="document-processing-flow" name="文档处理流程图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="文档处理模块流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- 输入 -->
        <mxCell id="input" value="原始文档" style="shape=folder;whiteSpace=wrap;html=1;folded=1" vertex="1" parent="1">
          <mxGeometry x="70" y="80" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- 步骤1：文档解析 -->
        <mxCell id="step1" value="步骤1&#xa;文档解析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="step1-detail" value="• PDF解析器&#xa;• Markdown解析器&#xa;• 文本解析器" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="80" y="295" width="80" height="45" as="geometry"/>
        </mxCell>

        <!-- 步骤2：内容提取 -->
        <mxCell id="step2" value="步骤2&#xa;内容提取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#388e3c;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="220" y="200" width="100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="step2-detail" value="• 文本内容提取&#xa;• 图像识别&#xa;• 多模态信息" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="230" y="295" width="80" height="45" as="geometry"/>
        </mxCell>

        <!-- 步骤3：文本分块 -->
        <mxCell id="step3" value="步骤3&#xa;文本分块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="370" y="200" width="100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="step3-detail" value="• 语义分块&#xa;• 重叠处理&#xa;• 元数据标注" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="380" y="295" width="80" height="45" as="geometry"/>
        </mxCell>

        <!-- 步骤4：向量化 -->
        <mxCell id="step4" value="步骤4&#xa;向量化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="200" width="100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="step4-detail" value="• 文本向量编码&#xa;• 嵌入模型调用&#xa;• 向量生成" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="530" y="295" width="80" height="45" as="geometry"/>
        </mxCell>

        <!-- 步骤5：索引存储 -->
        <mxCell id="step5" value="步骤5&#xa;索引存储" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="670" y="200" width="100" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="step5-detail" value="• 向量索引建立&#xa;• 元数据存储&#xa;• 持久化管理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="680" y="295" width="80" height="45" as="geometry"/>
        </mxCell>

        <!-- 输出 -->
        <mxCell id="output" value="向量数据" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15" vertex="1" parent="1">
          <mxGeometry x="820" y="200" width="100" height="70" as="geometry"/>
        </mxCell>

        <!-- 辅助模块 -->
        <mxCell id="helper-box" value="辅助模块" style="swimlane;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="70" y="420" width="850" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="md5" value="MD5校验" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="helper-box">
          <mxGeometry x="20" y="30" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="dedup" value="去重处理" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="helper-box">
          <mxGeometry x="150" y="30" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="error" value="错误处理" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="helper-box">
          <mxGeometry x="280" y="30" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="log" value="日志记录" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="helper-box">
          <mxGeometry x="410" y="30" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- 向量数据库 -->
        <mxCell id="vector-db" value="向量数据库" style="shape=cloud;whiteSpace=wrap;html=1" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666" edge="1" parent="1" source="input" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666" edge="1" parent="1" source="step5" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 辅助连接 -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#999999;dashed=1" edge="1" parent="1" source="md5" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#999999;dashed=1" edge="1" parent="1" source="dedup" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#999999;dashed=1" edge="1" parent="1" source="error" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#999999;dashed=1" edge="1" parent="1" source="log" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 向量库连接 -->
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#f57f17;dashed=1" edge="1" parent="1" source="vector-db" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#f57f17;dashed=1" edge="1" parent="1" source="output" target="vector-db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
