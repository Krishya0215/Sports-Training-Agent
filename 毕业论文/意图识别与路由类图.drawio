<mxfile host="app.diagrams.net">
  <diagram id="intent-router-class" name="意图识别与路由类图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="意图识别与路由类图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- IntentAnalyzer 类 -->
        <mxCell id="intent-class" value="&lt;b&gt;IntentAnalyzer&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="260" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="intent-attrs" value="&lt;div&gt;- keyword_mapping: Dict[str, List[str]]&lt;/div&gt;&lt;div&gt;- coach_catalog: Dict[str, Dict]&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="intent-class">
          <mxGeometry y="26" width="260" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="intent-line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="intent-class">
          <mxGeometry y="70" width="260" height="8" as="geometry"/>
        </mxCell>
        <mxCell id="intent-methods" value="&lt;div&gt;+ analyze_intent(question): Dict&lt;/div&gt;&lt;div&gt;+ match_keywords(question): List[str]&lt;/div&gt;&lt;div&gt;+ get_routing_decision(context): List[str]&lt;/div&gt;&lt;div&gt;+ is_new_user(user_id): bool&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="intent-class">
          <mxGeometry y="78" width="260" height="82" as="geometry"/>
        </mxCell>

        <!-- Router 类 -->
        <mxCell id="router-class" value="&lt;b&gt;Router&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="260" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="router-attrs" value="&lt;div&gt;- intent_analyzer: IntentAnalyzer&lt;/div&gt;&lt;div&gt;- selected_agents: List[str]&lt;/div&gt;&lt;div&gt;- execution_plan: List[List[str]]&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="router-class">
          <mxGeometry y="26" width="260" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="router-line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="router-class">
          <mxGeometry y="80" width="260" height="8" as="geometry"/>
        </mxCell>
        <mxCell id="router-methods" value="&lt;div&gt;+ route(question, context): List[str]&lt;/div&gt;&lt;div&gt;+ select_agents(intents): List[str]&lt;/div&gt;&lt;div&gt;+ build_execution_plan(agents): List[List[str]]&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="router-class">
          <mxGeometry y="88" width="260" height="72" as="geometry"/>
        </mxCell>

        <!-- KeywordMapping 类 -->
        <mxCell id="keyword-class" value="&lt;b&gt;KeywordMapping&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="750" y="80" width="280" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="keyword-content" value="&lt;div&gt;planning: [&quot;计划&quot;, &quot;规划&quot;, &quot;安排&quot;, &quot;周期&quot;, &quot;目标&quot;]&lt;/div&gt;&lt;div&gt;technique: [&quot;动作&quot;, &quot;姿势&quot;, &quot;技术&quot;, &quot;要领&quot;, &quot;标准&quot;]&lt;/div&gt;&lt;div&gt;fitness: [&quot;体能&quot;, &quot;疲劳&quot;, &quot;状态&quot;, &quot;评估&quot;, &quot;能力&quot;]&lt;/div&gt;&lt;div&gt;recovery: [&quot;恢复&quot;, &quot;康复&quot;, &quot;损伤&quot;, &quot;伤痛&quot;, &quot;拉伤&quot;]&lt;/div&gt;&lt;div&gt;safety: [&quot;安全&quot;, &quot;风险&quot;, &quot;危险&quot;, &quot;注意&quot;, &quot;防护&quot;]&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="keyword-class">
          <mxGeometry y="26" width="280" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="keyword-line" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="keyword-class">
          <mxGeometry y="160" width="280" height="8" as="geometry"/>
        </mxCell>
        <mxCell id="keyword-methods" value="&lt;div&gt;+ get_keywords_for_intent(intent): List[str]&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="keyword-class">
          <mxGeometry y="168" width="280" height="32" as="geometry"/>
        </mxCell>

        <!-- 路由决策框 -->
        <mxCell id="decision-box" value="路由决策逻辑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="340" width="260" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="decision-content" value="&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;1. 匹配关键词 → 确定意图类型&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;2. 单一意图 → 激活对应教练&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;3. 多重意图 → 激活所有匹配教练&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;4. 有伤病风险 → 强制激活康复教练&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;5. 新用户 → 激活所有教练&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;6. 构建执行计划 (批次化)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="410" y="360" width="240" height="140" as="geometry"/>
        </mxCell>

        <!-- 用户输入 -->
        <mxCell id="input-node" value="用户问题" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 执行计划 -->
        <mxCell id="output-node" value="执行计划" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="750" y="380" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 执行计划详情 -->
        <mxCell id="plan-detail" value="execution_plan示例:&#xa;[&quot;planning&quot;] →&#xa;[&quot;technique&quot;, &quot;recovery&quot;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="750" y="460" width="280" height="80" as="geometry"/>
        </mxCell>

        <!-- 关系线 - Router 依赖 IntentAnalyzer -->
        <mxCell id="rel1" value="" style="endArrow=open;endSize=12;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="router-class" target="intent-class">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 关系线 - IntentAnalyzer 使用 KeywordMapping -->
        <mxCell id="rel2" value="" style="endArrow=open;endSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="intent-class" target="keyword-class">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 关系线 - 用户输入到 IntentAnalyzer -->
        <mxCell id="rel3" value="analyze" style="endArrow=open;endSize=12;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="input-node" target="intent-class">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 关系线 - Router 产生执行计划 -->
        <mxCell id="rel4" value="" style="endArrow=open;endSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="router-class" target="output-node">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 关系线 - Router 使用决策逻辑 -->
        <mxCell id="rel5" value="" style="endArrow=open;endSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router-class" target="decision-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend-box" value="图例" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#f5f5f5;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="550" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="legend1" value="---&gt; 依赖/使用关系" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="legend-box">
          <mxGeometry y="26" width="200" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="legend2" value="○ 输入/输出节点" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="legend-box">
          <mxGeometry y="52" width="200" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="legend3" value="▇ 逻辑框/决策模块" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="legend-box">
          <mxGeometry y="78" width="200" height="26" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
