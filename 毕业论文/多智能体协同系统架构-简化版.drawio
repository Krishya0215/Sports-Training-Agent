        <mxCell id="batch2" value="第二批: 技术 + 康复 (并行)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="system-box">
          <mxGeometry x="215" y="405" width="190" height="30" as="geometry"/>
