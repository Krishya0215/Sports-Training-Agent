        </mxCell>
        <mxCell id="memory" value="记忆服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="380" width="120" height="50" as="geometry"/>
