        <mxCell id="batch3" value="第三批: 综合输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="system-box">
          <mxGeometry x="425" y="405" width="140" height="30" as="geometry"/>
        </mxCell>

        <!-- External Services -->
        <mxCell id="llm" value="大语言模型" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=13;" vertex="1" parent="1">
