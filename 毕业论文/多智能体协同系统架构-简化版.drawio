        <!-- Execution Order -->
        <mxCell id="batch-box" value="执行批次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontSize=12;" vertex="1" parent="system-box">
          <mxGeometry x="40" y="380" width="680" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="batch1" value="第一批: 训练规划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="system-box">
          <mxGeometry x="55" y="405" width="140" height="30" as="geometry"/>
