<mxfile host="app.diagrams.net">
  <diagram id="multi-agent-system" name="多智能体协同系统架构">
    <mxGraphModel dx="1422" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="多智能体协同系统架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- Input -->
        <mxCell id="input" value="用户请求" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- System Container -->
        <mxCell id="system-box" value="多智能体协同系统" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="770" height="380" as="geometry"/>
        </mxCell>

        <!-- Router -->
        <mxCell id="router" value="请求路由器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1976d2;fontSize=13;fontStyle=1;" vertex="1" parent="system-box">
          <mxGeometry x="40" y="40" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Workflow Engine -->
        <mxCell id="workflow" value="工作流引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#388e3c;fontSize=13;fontStyle=1;" vertex="1" parent="system-box">
          <mxGeometry x="220" y="40" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Coaches -->
        <mxCell id="planning" value="训练规划教练" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b3e5fc;strokeColor=#1565c0;fontSize=12;" vertex="1" parent="system-box">
          <mxGeometry x="400" y="40" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="technique" value="技术指导教练" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=12;" vertex="1" parent="system-box">
          <mxGeometry x="540" y="40" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="recovery" value="运动康复教练" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#e65100;fontSize=12;" vertex="1" parent="system-box">
          <mxGeometry x="470" y="110" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Synthesizer -->
        <mxCell id="synthesizer" value="综合输出器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#616161;fontSize=13;fontStyle=1;" vertex="1" parent="system-box">
          <mxGeometry x="400" y="190" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Workflow Process -->
        <mxCell id="process-box" value="工作流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#880e4f;fontSize=13;" vertex="1" parent="system-box">
          <mxGeometry x="40" y="270" width="680" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step1" value="1. 问题分类" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="system-box">
          <mxGeometry x="55" y="295" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="2. 知识检索" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="system-box">
