        </mxCell>
        <mxCell id="step3" value="3. 批次执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="system-box">
          <mxGeometry x="295" y="295" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="4. 并行处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="system-box">
          <mxGeometry x="415" y="295" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="step5" value="5. 综合整合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="system-box">
          <mxGeometry x="535" y="295" width="100" height="30" as="geometry"/>
