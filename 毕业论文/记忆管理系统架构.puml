@startuml 记忆管理系统架构图
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70

title <size:18>记忆管理系统详细架构</size>

package "记忆管理模块\n(Memory Manager)" as memory #E0F7FA {

    component "工作记忆\n(Working Memory)" as working {
        note bottom : 短期记忆\n容量: 5轮对话
        component "对话上下文" as ctx
        component "消息队列" as queue
        component "会话管理" as session
    }

    component "情景记忆\n(Episodic Memory)" as episodic {
        note bottom : 中期记忆\n记录事件与查询
        component "查询历史" as history
        component "训练事件" as training_events
        component "学习事件" as learning_events
    }

    component "语义记忆\n(Semantic Memory)" as semantic {
        note bottom : 长期记忆\n概念化知识
        component "概念知识库" as concepts
        component "用户画像" as profile
        component "训练偏好" as preferences
        component "约束条件" as constraints
    }

    component "感知记忆\n(Perceptual Memory)" as perceptual {
        note bottom : 感知特征\n文档与图像
        component "文档特征" as doc_features
        component "图像描述" as image_desc
    }

    component "记忆整合服务\n(Consolidation)" as consolidation {
        [记忆提取]
        [短期转长期]
        [知识更新]
        [遗忘机制]
    }

    component "记忆服务\n(MemoryService)" as service {
        [统一读取接口]
        [记忆提示词构建]
        [训练规律分析]
    }
}

' 数据存储
database "关系数据库\n(SQLite)" as db #ECEFF1 {
    [工作记忆表]
    [情景记忆表]
    [语义记忆表]
    [训练记录表]
}

' 外部服务
component "多智能体系统" as agent #FCE4EC
component "后端API" as api #FFF3E0
component "大语言模型" as llm #FFF8E1

' 记忆写入流程
agent --> service : 记录交互
service --> working : 写入上下文
service --> episodic : 记录事件
service --> semantic : 更新知识
service --> perceptual : 存储特征

' 记忆整合
consolidation --> semantic : 提取整合
consolidation --> episodic : 事件存储
consolidation --> db : 持久化

' 记忆读取流程
api --> service : 请求记忆
service --> working : 获取上下文
service --> episodic : 查询历史
service --> semantic : 获取画像
service --> service : 构建提示词
service --> api : 返回记忆
api --> llm : 注入提示词

' 数据持久化
working --> db
episodic --> db
semantic --> db
perceptual --> db

' 语义记忆详细结构
note right of semantic
  语义记忆分类:
  - profile: 目标、水平、年龄
  - preference: 训练偏好、时间偏好
  - habit: 训练习惯、行为模式
  - constraint: 伤病、限制条件
  - risk: 风险因素
end note

' 训练规律分析
note bottom of service
  训练规律分析:
  - 训练频率趋势
  - 训练类型偏好
  - 疲劳/疼痛模式
  - 完成率统计
  - 风险因素识别
end note

@enduml
